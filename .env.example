# =============================================================================
# MentorMinds Backend — Environment Variables
# Copy this file to .env and fill in your values.
# For local overrides (developer machines), create .env.local — it takes
# precedence over .env and should never be committed to version control.
# =============================================================================
DAILY_API_KEY=
WHEREBY_API_KEY=
VIDEO_PROVIDER=daily

# -----------------------------------------------------------------------------
# Session No-Show Detection (%983)
# -----------------------------------------------------------------------------
NO_SHOW_GRACE_PERIOD_MINUTES=10  # Time after scheduled start before marking as no-show
NO_SHOW_DISPUTE_WINDOW_HOURS=24  # Time the no-show offender has to dispute the marking
NO_SHOW_MENTEE_REFUND_PERCENT=100  # Escrow % refunded to mentee when the MENTOR no-shows
NO_SHOW_MENTOR_PAYOUT_PERCENT=50  # Escrow % paid to mentor when the MENTEE no-shows (reduced payout)

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development           # development | test | production
PORT=5000                      # Port the HTTP server listens on
API_VERSION=v1                 # API version prefix (e.g. /api/v1)

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — DATABASE_URL is required
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mentorminds
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mentorminds
DB_USER=postgres
DB_PASSWORD=your_password      # Required — never commit real passwords
DB_POOL_MAX=20                 # Max connections (tune via load test)
DB_POOL_MIN=4                  # Minimum idle connections
DB_IDLE_TIMEOUT_MS=30000       # Close idle clients after 30s
DB_CONNECTION_TIMEOUT_MS=2000  # Fail fast when pool is saturated
DB_STATEMENT_TIMEOUT_MS=10000  # Cancel queries running longer than 10s
DB_POOL_EXHAUSTION_THRESHOLD=90  # Alert when pool utilization exceeds %

# -----------------------------------------------------------------------------
# JWT — secrets must be at least 32 characters
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-random-32-char-minimum-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-to-a-different-random-32-char-secret
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# File Signing — separate secret for file access tokens (prevents conflation with JWT_SECRET)
# This secret is used for HMAC signing of file access tokens. It must be at least 32 characters.
# NEVER reuse JWT_SECRET here — keep these secrets separate to allow independent rotation.
# -----------------------------------------------------------------------------
FILE_SIGNING_SECRET=change-this-to-a-different-random-32-char-secret-for-files

# -----------------------------------------------------------------------------
# Cache Key Signing — HMACs the userId component of authenticated cache keys so
# keys can't be enumerated. Optional: falls back to FILE_SIGNING_SECRET if unset.
# -----------------------------------------------------------------------------
CACHE_KEY_HMAC_SECRET=change-this-to-a-different-random-32-char-secret-for-cache

# -----------------------------------------------------------------------------
# Stellar Network
# -----------------------------------------------------------------------------
STELLAR_NETWORK=testnet        # testnet | mainnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

STELLAR_FUNDING_SECRET=

# Platform wallet — leave blank in development if not needed
# When HSM is enabled (HSM_PROVIDER=aws_cloudhsm|pkcs11), the signing secret
# must NOT be set here — it lives inside the HSM token (issue #982).
PLATFORM_PUBLIC_KEY=
PLATFORM_SECRET_KEY=           # Sensitive — never log or expose this value

# Public key of the HSM-provisioned platform Stellar key (issue #982).
# Required when HSM_PROVIDER=aws_cloudhsm|pkcs11.
STELLAR_FUNDING_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Hardware Security Module (HSM) — Stellar / Soroban signing (issue #982)
# -----------------------------------------------------------------------------
# provider: software (dev only) | softhsm | pkcs11 | aws_cloudhsm
HSM_PROVIDER=software
HSM_ENABLED=false

# PKCS#11 (/ SoftHSM2) adapter
HSM_PKCS11_LIBRARY_PATH=/usr/lib/softhsm/libsofthsm2.so
HSM_PKCS11_SLOT=0
HSM_PKCS11_USER_PIN=
HSM_PKCS11_SO_PIN=
HSM_PKCS11_READ_ONLY=false
HSM_PKCS11_MAX_SESSIONS=10
HSM_TOKEN_LABEL=MentorMindsHSM

# AWS CloudHSM adapter
HSM_AWS_CLUSTER_ID=
HSM_AWS_REGION=us-east-1
HSM_AWS_CRYPTO_USER=
HSM_AWS_CRYPTO_USER_PASSWORD=
HSM_AWS_CA_CERT_PATH=
HSM_AWS_MAX_CONCURRENCY=20

# Rotation / retention / escrow / compliance
HSM_KEY_ROTATION_DAYS=90
HSM_ASYMMETRIC_KEY_ROTATION_DAYS=365
HSM_AUTO_ROTATE=true
HSM_KEY_RETENTION_DAYS=30
HSM_MAX_KEY_VERSIONS=5
HSM_NOTIFY_ON_ROTATION=true
HSM_ESCROW_STORE=aws_secrets        # aws_secrets | vault | database | none
HSM_ESCROW_THRESHOLD=2
HSM_ESCROW_TOTAL_SHARES=3
HSM_ESCROW_CUSTODIAN_KEYS=
HSM_FIPS_LEVEL=3
HSM_AUDIT_ALL_OPS=true
HSM_AUDIT_RETENTION_DAYS=2555
HSM_TIMEOUT_MS=5000
HSM_MAX_RETRIES=3
HSM_RETRY_DELAY_MS=500

# -----------------------------------------------------------------------------
# Soroban Smart Contracts (Stellar)
# -----------------------------------------------------------------------------
# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Vesting Contract
SOROBAN_VESTING_CONTRACT_ADDRESS=
VESTING_CONTRACT_ADDRESS=      # Alternative name (same as above)

# Escrow Contract
SOROBAN_ESCROW_CONTRACT_ADDRESS=
ESCROW_CONTRACT_ADDRESS=       # Alternative name (same as above)

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000    # Window in ms (default: 15 minutes)
RATE_LIMIT_MAX_REQUESTS=100    # Max requests per window per IP

# Auth endpoints
RATE_LIMIT_AUTH_MAX=10         # Max auth attempts per 15 min window (default: 10)

# API endpoints (authenticated)
RATE_LIMIT_API_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_API_MAX=60          # Max requests per minute per user

# Sensitive endpoints (password reset, etc.)
RATE_LIMIT_SENSITIVE_MAX=5     # Max per hour

# -----------------------------------------------------------------------------
# Redis (optional — used for caching and session storage)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Redis Cluster configuration (set REDIS_CLUSTER_ENABLED=true to use)
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002
REDIS_TLS_ENABLED=false

# -----------------------------------------------------------------------------
# DeFi wallet aggregation
# -----------------------------------------------------------------------------
DEFI_WALLET_USE_MOCKS=false
DEFI_ETHEREUM_AAVE_SUBGRAPH_URL=
DEFI_ETHEREUM_COMPOUND_SUBGRAPH_URL=
DEFI_POLYGON_AAVE_SUBGRAPH_URL=
DEFI_POLYGON_COMPOUND_SUBGRAPH_URL=

# Microservices URLs
AUTH_SERVICE_URL=http://localhost:5001
USER_SERVICE_URL=http://localhost:5002
BOOKING_SERVICE_URL=http://localhost:5003
PAYMENT_SERVICE_URL=http://localhost:5004
NOTIFICATION_SERVICE_URL=http://localhost:5005
ANALYTICS_SERVICE_URL=http://localhost:5006

# -----------------------------------------------------------------------------
# Docker Compose (local stack: api + postgres + redis)
# -----------------------------------------------------------------------------
# When using `npm run docker:dev` or `docker compose up`, point DB/Redis at service names:
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}
# DB_HOST=postgres
# REDIS_URL=redis://redis:6379
# Copy this file to `.env` and fill credentials before running compose (no secrets in YAML).

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug                # debug | info | warn | error
LOG_FILE_PATH=logs             # Directory for rotated log files (production only)
LOG_MAX_SIZE=20m               # Max size per log file before rotation
LOG_MAX_FILES=14d              # Retention period for rotated log files

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=10               # Cost factor for password hashing
ENCRYPTION_KEY=change-this-to-a-random-32-char-minimum-secret  # AES-256 encryption key
MFA_TOTP_ISSUER=MentorMinds     # Issuer name shown in authenticator apps

# -----------------------------------------------------------------------------
# Platform
# -----------------------------------------------------------------------------
PLATFORM_FEE_PERCENTAGE=5      # Percentage fee taken on each transaction

# -----------------------------------------------------------------------------
# Meeting Provider (Video Conferencing)
# -----------------------------------------------------------------------------
# Options: daily, whereby, zoom, jitsi
# - Daily.co: Professional video rooms with API (https://daily.co)
# - Whereby: Simple embedded video rooms (https://whereby.com)
# - Zoom: Enterprise video conferencing (https://zoom.us)
# - Jitsi: Free, self-hosted option (https://jitsi.org)
MEETING_PROVIDER=daily          # Choose one: daily, whereby, zoom, jitsi
MEETING_API_KEY=your_api_key_here  # Required for Daily, Whereby, Zoom
MEETING_API_SECRET=              # Optional: Additional secret for some providers
MEETING_ROOM_EXPIRY_MINUTES=30   # Meeting rooms expire 30 minutes after session end
MEETING_RETRY_ATTEMPTS=1         # Number of retry attempts if provider API fails

# Jitsi specific (only needed if using self-hosted Jitsi)
JITSI_BASE_URL=https://meet.jit.si

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (Push Notifications)
# -----------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# -----------------------------------------------------------------------------
# Error Monitoring & Tracking
# -----------------------------------------------------------------------------
# Sentry - Get your DSN from https://sentry.io > Project Settings > Client Keys
# Leave blank to disable Sentry (e.g. in local development)
SENTRY_DSN=

# DataDog - Get credentials from https://app.datadoghq.com > Organization Settings > API Keys
# Leave blank to disable DataDog logging
DATADOG_CLIENT_TOKEN=

# -----------------------------------------------------------------------------
# AI Services (Session Summaries)
# -----------------------------------------------------------------------------
# OpenAI API for session summary generation
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API for session summary generation (fallback)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Perspective API for content moderation (optional)
# Get your API key from https://console.cloud.google.com/apis/api/perspectivecommentanalyzer.googleapis.com
PERSPECTIVE_API_KEY=

# -----------------------------------------------------------------------------
# Internationalization (i18n)
# -----------------------------------------------------------------------------
# Default language for the platform
DEFAULT_LANGUAGE=en

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=en,es,fr,de,zh,ja
DATADOG_SITE=datadoghq.com     # Options: datadoghq.com, datadoghq.eu, us3.datadoghq.com, etc.

# -----------------------------------------------------------------------------
# Secrets Management
# -----------------------------------------------------------------------------
# SECRETS_PROVIDER=env        # env (default) | aws | vault
#
# AWS Secrets Manager (SECRETS_PROVIDER=aws):
# AWS_REGION=us-east-1
# AWS_SECRET_ID=mentorminds/prod/app-secrets
#
# HashiCorp Vault (SECRETS_PROVIDER=vault):
# VAULT_ADDR=https://vault.internal
# VAULT_TOKEN=your-vault-token
# VAULT_SECRET_PATH=secret/data/mentorminds/prod
SECRETS_PROVIDER=env

# JWT key rotation — set during rotation, remove after old tokens expire
# JWT_SECRET_PREVIOUS=

# -----------------------------------------------------------------------------
# OAuth2 / Social Login
# -----------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# LinkedIn OAuth (OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/v1/auth/linkedin/callback

# Microsoft OAuth (Azure AD v2)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/v1/auth/microsoft/callback

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# AWS S3 Configuration
AWS_S3_BUCKET=my-bucket
AWS_ACCESS_KEY_ID=my-access-key
AWS_SECRET_ACCESS_KEY=my-secret-key
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Email Provider
# -----------------------------------------------------------------------------
# Choose: sendgrid | mailgun | smtp (default: smtp)
EMAIL_PROVIDER=smtp

# SendGrid — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Mailgun — https://app.mailgun.com/app/account/security/api_keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_HOST=api.mailgun.net   # Use api.eu.mailgun.net for EU region

# Shared webhook secret for verifying bounce/complaint callbacks from SendGrid/Mailgun
EMAIL_WEBHOOK_SECRET=

# Legacy SMTP fallback (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_PASS=
FROM_EMAIL=noreply@mentorminds.com

# -----------------------------------------------------------------------------
# Elasticsearch (Advanced Search)
# -----------------------------------------------------------------------------
# Elasticsearch node URL
ELASTICSEARCH_URL=http://localhost:9200
# Elasticsearch username (if using security)
ELASTICSEARCH_USERNAME=
# Elasticsearch password (if using security)
ELASTICSEARCH_PASSWORD=
# Elasticsearch API key (alternative to username/password)
ELASTICSEARCH_API_KEY=
# Enable/disable Elasticsearch (fallback to PostgreSQL if disabled)
ELASTICSEARCH_ENABLED=true
# Index name prefix (e.g., mentorminds)
ELASTICSEARCH_INDEX_PREFIX=mentorminds

# -----------------------------------------------------------------------------
# Video Recording (AWS IVS / Agora)
# -----------------------------------------------------------------------------
# Recording provider: ivs | agora | manual
RECORDING_PROVIDER=manual
# AWS IVS Configuration
AWS_IVS_CHANNEL_ARN=
AWS_IVS_REGION=us-east-1
# Agora Configuration
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Recording retention period in days (default: 90)
RECORDING_RETENTION_DAYS=90
# Enable automatic transcription
RECORDING_TRANSCRIPTION_ENABLED=false
# Transcription provider: aws | google | openai
TRANSCRIPTION_PROVIDER=aws

# -----------------------------------------------------------------------------
# API Documentation Portal
# -----------------------------------------------------------------------------
# Enables /api/v1/sandbox/* fixture routes and the Swagger UI "Sandbox" server
# option, so third-party developers can try endpoints with no real side effects.
SANDBOX_MODE=false

# -----------------------------------------------------------------------------
# CDN Configuration (issue #745)
# See docs/cdn-configuration.md for provider setup instructions.
# -----------------------------------------------------------------------------
CDN_PROVIDER=                  # cloudfront | cloudflare | fastly
CDN_BASE_URL=                  # e.g. https://assets.mentorminds.com
CDN_DOMAINS=                   # Comma-separated multi-domain list (optional)
CDN_IMAGE_RESIZE=true
CDN_WEBP_CONVERSION=true
CDN_COMPRESSION=true

# CloudFront
CDN_CLOUDFRONT_DISTRIBUTION_ID=

# Cloudflare
CDN_CLOUDFLARE_ZONE_ID=
CDN_CLOUDFLARE_API_TOKEN=

# Fastly
CDN_FASTLY_SERVICE_ID=
CDN_FASTLY_API_KEY=

# -----------------------------------------------------------------------------
# Email CDN Assets (issue #752)
# -----------------------------------------------------------------------------
# Mailing address shown in email footers (CAN-SPAM / GDPR compliance).
COMPANY_ADDRESS=MentorMinds, Inc. — mentorminds.com
# Override asset base URL for email icon/logo hosting (falls back to CDN_BASE_URL, then APP_BASE_URL).
EMAIL_ASSETS_BASE_URL=
